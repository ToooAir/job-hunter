# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "openai" | "azure" | "mistral" | "custom"
LLM_PROVIDER=openai

# ── OpenAI (LLM_PROVIDER=openai) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here

# ── Mistral AI (LLM_PROVIDER=mistral) ─────────────────────────────────────────
# Uses Mistral's OpenAI-compatible API. JSON mode only (no Structured Outputs).
# Chat model default: mistral-large-latest
# Embedding model default: mistral-embed (1024-dim — rebuild KB if switching from OpenAI)
# MISTRAL_API_KEY=your_mistral_api_key_here
# CHAT_MODEL=mistral-large-latest
# EMB_MODEL=mistral-embed
# MISTRAL_MAX_CONCURRENT=3
# Free-tier quotas are per model family (small/medium: 20k TPM each). Route the
# JD translation call to another family than CHAT_MODEL to use two buckets.
# TRANSLATION_MODEL=mistral-small-2603

# ── Azure OpenAI (LLM_PROVIDER=azure) ─────────────────────────────────────────
# AZURE_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-08-01-preview
# AZURE_CHAT_DEPLOYMENT=gpt-4o
# AZURE_EMB_DEPLOYMENT=text-embedding-3-small
# Reasoning models (GPT-5 family): reasoning_effort for every chat call.
# "low" is right for scoring/translation; unset → parameter not sent.
# CHAT_REASONING_EFFORT=low
# TRANSLATION_MODEL=gpt-5-nano          # cheaper deployment for JD translation

# ── Custom endpoint (LLM_PROVIDER=custom) ─────────────────────────────────────
# Compatible with LiteLLM proxy, Ollama, vLLM, GitHub Models, etc.
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=gpt-4o
# EMB_MODEL=text-embedding-3-small

# ── Storage paths ─────────────────────────────────────────────────────────────
DB_PATH=./data/jobs.db
QDRANT_PATH=./qdrant_data

# ── Levels.fyi salary reference ───────────────────────────────────────────────
# Home country slug for remote jobs (used as fallback location for Levels.fyi queries)
HOME_COUNTRY=germany
# Minimum entries required before falling back to a broader region
# LEVELS_MIN_ENTRIES=3
# Cache TTL in days (default: 7)
# LEVELS_CACHE_TTL_DAYS=7
