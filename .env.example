# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: "openai" | "azure" | "mistral" | "custom"
# Each provider block below holds only credentials and provider-specific names.
# Model routing and behaviour knobs that apply to every provider are in the
# "Model routing" block after them.
LLM_PROVIDER=openai

# ── OpenAI (LLM_PROVIDER=openai) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here

# ── Mistral AI (LLM_PROVIDER=mistral) ─────────────────────────────────────────
# Uses Mistral's OpenAI-compatible API. JSON mode only (no Structured Outputs).
# Embedding model default: mistral-embed (1024-dim — rebuild KB when switching)
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MAX_CONCURRENT=3          # scoring workers (also used by other providers)

# ── Azure OpenAI (LLM_PROVIDER=azure) ─────────────────────────────────────────
# Uses OPENAI_API_KEY as the Azure key. Models are addressed by DEPLOYMENT name:
# AZURE_CHAT_DEPLOYMENT replaces CHAT_MODEL, and TRANSLATION_MODEL below takes a
# deployment name too (e.g. gpt-5-nano).
# AZURE_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-12-01-preview
# AZURE_CHAT_DEPLOYMENT=gpt-5.6-luna
# AZURE_EMB_DEPLOYMENT=text-embedding-3-small

# ── Custom endpoint (LLM_PROVIDER=custom) ─────────────────────────────────────
# Compatible with LiteLLM proxy, Ollama, vLLM, GitHub Models, etc.
# CUSTOM_BASE_URL=http://localhost:11434/v1

# ── Model routing (all providers) ─────────────────────────────────────────────
# CHAT_MODEL: scoring, cover letters, briefs, Answer Panel (ignored on azure —
#   AZURE_CHAT_DEPLOYMENT is used instead). Mistral default mistral-small-2603.
# CHAT_MODEL=gpt-4o
# EMB_MODEL: embeddings for the candidate KB (ignored on azure). Changing the
#   embedding model means `python utils/kb_loader.py` — dimensions and the
#   similarity scale both change (see KB_SCORE_THRESHOLD).
# EMB_MODEL=text-embedding-3-small
# TRANSLATION_MODEL: the German→English JD translation call. Cheap and
#   low-stakes, so route it to a cheaper model / another rate bucket
#   (mistral-small-2603 next to mistral-medium; gpt-5-nano next to luna).
#   Unset → same as the chat model.
# TRANSLATION_MODEL=gpt-5-nano
# CHAT_REASONING_EFFORT: reasoning_effort sent with every chat call. "low" is
#   right for scoring/translation. Unset → not sent. Models that reject the
#   parameter (and temperature / max_tokens) are detected from the first 400
#   and the call is retried without it — no per-model configuration needed.
# CHAT_REASONING_EFFORT=low
# KB_SCORE_THRESHOLD: cosine floor for KB retrieval. Default follows the
#   embedding model (text-embedding-3-*: 0.35, mistral-embed: 0.60).
# KB_SCORE_THRESHOLD=0.35

# ── Storage paths ─────────────────────────────────────────────────────────────
DB_PATH=./data/jobs.db
QDRANT_PATH=./qdrant_data

# ── Levels.fyi salary reference ───────────────────────────────────────────────
# Home country slug for remote jobs (used as fallback location for Levels.fyi queries)
HOME_COUNTRY=germany
# Minimum entries required before falling back to a broader region
# LEVELS_MIN_ENTRIES=3
# Cache TTL in days (default: 7)
# LEVELS_CACHE_TTL_DAYS=7
